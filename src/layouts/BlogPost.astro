---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MediaLink from '../components/MediaLink.astro';
import ShareShortcut from '../components/ShareShortcut.astro';
import { getShortcutUrl } from '../utils/shortcuts';
import { getYoutubeThumbnail } from '../utils/youtube';
import 'katex/dist/katex.min.css';

type Props = CollectionEntry<'blog'>['data'] & {
	slug: string;
};

const { title, description, pubDate, updatedDate, heroImage, youtube, slug } = Astro.props;
const shortcutUrl = getShortcutUrl(slug);
const youtubeThumbnail = youtube
	? (youtube.thumbnail ?? getYoutubeThumbnail(youtube.url))
	: null;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.inspiration {
				margin-top: 2.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.inspiration-label {
				margin: 0 0 1em;
				font-size: 0.92em;
				color: rgb(var(--gray));
			}
			.title-actions {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin: 0 0 0.75em;
			}
			.back-to-list {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.4em;
				border-radius: 8px;
				color: rgb(var(--gray));
				text-decoration: none;
				transition:
					color 0.15s,
					background 0.15s;
			}
			.back-to-list:hover {
				color: rgb(var(--gray-dark));
				background: rgba(var(--gray-light), 0.35);
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
				}
				.prose {
					max-width: 100%;
					padding: 1em 0;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<div class="title-actions">
							<a href="/blog" class="back-to-list" aria-label="블로그 목록" title="블로그 목록">
								<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
									<path
										fill="currentColor"
										d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5Zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5Zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5Z"
									></path>
								</svg>
							</a>
							{shortcutUrl && <ShareShortcut url={shortcutUrl} />}
						</div>
						<hr />
					</div>
					<slot />
					{
						youtube && youtubeThumbnail && (
							<section class="inspiration">
								<p class="inspiration-label">이 글은 아래 영상에서 영감을 받아 작성했습니다.</p>
								<MediaLink
									href={youtube.url}
									image={youtubeThumbnail}
									title={youtube.title}
									subtitle={youtube.subtitle}
								/>
							</section>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
