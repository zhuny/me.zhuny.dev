---
interface Props {
	href: string;
	title: string;
	description?: string;
}

const { href, title, description } = Astro.props;
---

<a class="card-link" href={href}>
	<span class="card-link__content">
		<span class="card-link__title">{title}</span>
		{description && <span class="card-link__description">{description}</span>}
	</span>
	<span class="card-link__arrow" aria-hidden="true">→</span>
</a>

<style>
	.card-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.15em 1.35em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		background: linear-gradient(
			145deg,
			rgba(var(--gray-light), 0.85),
			rgba(20, 24, 33, 0.95)
		);
		box-shadow: var(--box-shadow);
		color: rgb(var(--black));
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	.card-link:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		box-shadow:
			0 4px 12px rgba(107, 138, 255, 25%),
			0 12px 28px rgba(0, 0, 0, 55%);
		background: linear-gradient(
			145deg,
			rgba(107, 138, 255, 12%),
			rgba(20, 24, 33, 0.98)
		);
	}

	.card-link:active {
		transform: translateY(-1px);
	}

	.card-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.card-link__content {
		display: flex;
		flex-direction: column;
		gap: 0.2em;
		min-width: 0;
	}

	.card-link__title {
		font-size: 1.15em;
		font-weight: 700;
		line-height: 1.3;
	}

	.card-link__description {
		font-size: 0.9em;
		font-weight: 400;
		color: rgb(var(--gray));
		line-height: 1.4;
	}

	.card-link__arrow {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25em;
		height: 2.25em;
		border-radius: 50%;
		background: rgba(var(--gray-light), 0.6);
		color: var(--accent);
		font-size: 1.25em;
		line-height: 1;
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}

	.card-link:hover .card-link__arrow {
		background: rgba(107, 138, 255, 20%);
		transform: translateX(4px);
	}
</style>
