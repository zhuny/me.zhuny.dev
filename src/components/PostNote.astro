---
interface Props {
	thx?: string;
	thumbnail?: boolean;
}

const { thx, thumbnail } = Astro.props;
---

<div class="post-note">
	{thumbnail && <p>Thumbnail generated by AI</p>}
	<slot />
	{thx && <p>Special thanks to {thx}</p>}
</div>

<style>
	.post-note {
		margin: 0 0 2em;
		font-size: 0.88em;
		color: rgb(var(--gray));
		line-height: 1.6;
		text-align: center;
	}

	.post-note :global(p) {
		margin: 0 0 0.4em;
	}

	.post-note :global(p:last-child) {
		margin-bottom: 0;
	}
</style>
