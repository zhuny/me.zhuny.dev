---
interface Props {
	url: string;
}

const { url } = Astro.props;
---

<button type="button" class="share-shortcut" data-url={url} aria-label="숏링크 복사" title="숏링크 복사">
	<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
		<path
			fill="currentColor"
			d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-1H4a1 1 0 0 1-1-1V1.5Zm5 0v1h4a2 2 0 0 1 2 2v8h1V4.5A2.5 2.5 0 0 0 9.5 1.5H9ZM6 4.5A1.5 1.5 0 0 1 7.5 3h5A1.5 1.5 0 0 1 14 4.5v5A1.5 1.5 0 0 1 12.5 11h-5A1.5 1.5 0 0 1 6 9.5v-5Z"
		></path>
	</svg>
</button>

<style>
	.share-shortcut {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.4em;
		border: none;
		border-radius: 8px;
		background: transparent;
		color: rgb(var(--gray));
		cursor: pointer;
		transition:
			color 0.15s,
			background 0.15s;
	}

	.share-shortcut:hover {
		color: rgb(var(--gray-dark));
		background: rgba(var(--gray-light), 0.35);
	}

	.share-shortcut.is-copied {
		color: var(--accent);
	}
</style>

<script>
	async function copyToClipboard(text: string): Promise<boolean> {
		if (navigator.clipboard?.writeText) {
			try {
				await navigator.clipboard.writeText(text);
				return true;
			} catch {
				// secure context가 아니거나 권한이 없을 때 폴백으로 진행
			}
		}

		const textarea = document.createElement('textarea');
		textarea.value = text;
		textarea.setAttribute('readonly', '');
		textarea.style.position = 'fixed';
		textarea.style.left = '-9999px';
		document.body.appendChild(textarea);
		textarea.select();
		textarea.setSelectionRange(0, text.length);

		let copied = false;
		try {
			copied = document.execCommand('copy');
		} finally {
			document.body.removeChild(textarea);
		}

		return copied;
	}

	document.querySelectorAll<HTMLButtonElement>('.share-shortcut').forEach((button) => {
		button.addEventListener('click', async () => {
			const url = button.dataset.url;
			if (!url) return;

			const copied = await copyToClipboard(url);

			if (!copied) {
				window.prompt('아래 링크를 복사하세요:', url);
				return;
			}

			const originalLabel = button.getAttribute('aria-label') ?? '숏링크 복사';
			button.classList.add('is-copied');
			button.setAttribute('aria-label', '복사됨!');
			button.title = '복사됨!';

			window.setTimeout(() => {
				button.classList.remove('is-copied');
				button.setAttribute('aria-label', originalLabel);
				button.title = originalLabel;
			}, 2000);
		});
	});
</script>
